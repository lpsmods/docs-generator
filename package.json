{
  "name": "@lpsmods/docs-generator",
  "version": "1.0.0",
  "description": "Generate Markdown API documentation from source code with Tree-sitter and Mustache",
  "keywords": [
    "documentation",
    "markdown",
    "mustache",
    "tree-sitter",
    "docgen"
  ],
  "repository": {
    "type": "git",
    "url": "docs-generator"
  },
  "license": "MIT",
  "author": "Legopitstop",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docs-generator": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test",
    "gen:docs": "docs-generator src -o docs"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "mustache": "^4.2.0",
    "pacote": "^21.5.1",
    "tar": "^7.5.20",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "@types/pacote": "^11.1.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
