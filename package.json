{
  "name": "@lpsmods/docs-generator",
  "version": "0.0.1-alpha.5",
  "description": "Generate Markdown API documentation from source code with Tree-sitter and Mustache",
  "keywords": [
    "documentation",
    "markdown",
    "mustache",
    "tree-sitter",
    "docgen"
  ],
  "homepage": "https://docs.lpsmods.dev/@lpsmods/docs-generator",
  "funding": "https://github.com/sponsors/legopitstop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpsmods/docs-generator.git"
  },
  "bugs": {
    "url": "https://github.com/lpsmods/docs-generator/issues"
  },
  "license": "MIT",
  "author": "Legopitstop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docs-generator": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test",
    "gen:docs": "npm run build && node ./generate.js"
  },
  "dependencies": {
    "mustache": "^4.2.0",
    "pacote": "^21.5.1",
    "tar": "^7.5.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.1",
    "@types/pacote": "^11.1.8",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
